model AccreditationFinding {
 id String @id @default(cuid())
 title String
 accreditationStandardId String
 findingText String
 receivedAt DateTime
 severity String
 responseDueAt DateTime
 status String @default("Draft")
 accreditationCycleId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([accreditationCycleId])
 linkedAccreditationStandardId AccreditationStandard @relation("AccreditationFinding_accreditationStandardId", fields: [accreditationStandardId], references: [id], onDelete: Restrict)
 linkedAccreditationCycleId AccreditationCycle @relation("AccreditationFinding_accreditationCycleId", fields: [accreditationCycleId], references: [id], onDelete: Restrict)
