// Generated schema — modeled after beautyhqio conventions.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  active       Boolean @default(true)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model WorkflowAnalysis {
 id String @id @default(cuid())
 actorId String
 workflow String
 subjectEntity String
 subjectId String
 input Json
 evidence Json
 evidenceHash String
 result Json
 model String
 receipt String?
 createdAt DateTime @default(now())
 @@index([workflow, createdAt])
}
model RecordReview {
 id String @id @default(cuid())
 actorId String
 entity String
 entityId String
 version String
 reason String
 createdAt DateTime @default(now())
 @@unique([entity, entityId, version, actorId])
}
model UsageBucket {
 id String @id
 calls Int
}
model IssuedCredential {
 token String @id
 entity String
 entityId String
 version String
 assertion Json
 createdAt DateTime @default(now())
 revokedAt DateTime?
 @@index([entity, entityId, createdAt])
}

model DomainArtifact {
 id String @id @default(cuid())
 subjectEntity String
 subjectId String
 title String
 content String
 contentHash String
 actorId String
 approvedBy String?
 createdAt DateTime @default(now())
 @@index([subjectEntity, subjectId])
}

model RecordApproval {
 id String @id
 version String
}
model DomainExecution {
 id String @id
 actorId String
 connectorId String
 action String
 subjectEntity String
 subjectId String
 version String
 status String
 result Json?
 createdAt DateTime @default(now())
}

model WorkSession {
 id String @id @default(cuid())
 actorId String
 respondentId String
 subjectEntity String
 subjectId String
 questions Json
 answers Json
 currentQuestion String?
 status String
 deadline DateTime
 createdAt DateTime @default(now())
 @@index([respondentId, createdAt])
}
model SessionMedia {
 id String @id @default(cuid())
 sessionId String
 questionId String
 actorId String
 contentType String
 bytes Bytes
 contentHash String
 createdAt DateTime @default(now())
 @@index([sessionId])
}

model AppSetting {
 id String @id
 value Json
 updatedAt DateTime @updatedAt
}

model AccreditationCycle {
 id String @id @default(cuid())
 name String
 institution String
 accreditor String
 frameworkVersion String
 cycleStart DateTime
 visitAt DateTime
 status String @default("Draft")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 inverseAccreditationStandard_accreditationCycleId AccreditationStandard[] @relation("AccreditationStandard_accreditationCycleId")
 inverseStandardEvidence_accreditationCycleId StandardEvidence[] @relation("StandardEvidence_accreditationCycleId")
 inverseAssessmentMeasure_accreditationCycleId AssessmentMeasure[] @relation("AssessmentMeasure_accreditationCycleId")
 inverseSelfStudySection_accreditationCycleId SelfStudySection[] @relation("SelfStudySection_accreditationCycleId")
 inverseSiteVisitRequest_accreditationCycleId SiteVisitRequest[] @relation("SiteVisitRequest_accreditationCycleId")
 inverseAccreditationFinding_accreditationCycleId AccreditationFinding[] @relation("AccreditationFinding_accreditationCycleId")
 inverseImprovementAction_accreditationCycleId ImprovementAction[] @relation("ImprovementAction_accreditationCycleId")
 inverseCommitteeMeeting_accreditationCycleId CommitteeMeeting[] @relation("CommitteeMeeting_accreditationCycleId")
 inverseOperationalTask_accreditationCycleId OperationalTask[] @relation("OperationalTask_accreditationCycleId")
 inverseRuleVersion_accreditationCycleId RuleVersion[] @relation("RuleVersion_accreditationCycleId")
 inverseDocumentRequirement_accreditationCycleId DocumentRequirement[] @relation("DocumentRequirement_accreditationCycleId")
}

model AccreditationStandard {
 id String @id @default(cuid())
 name String
 standardCode String
 requirementText String
 owner String
 dueAt DateTime
 status String @default("Draft")
 accreditationCycleId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([accreditationCycleId])
 linkedAccreditationCycleId AccreditationCycle @relation("AccreditationStandard_accreditationCycleId", fields: [accreditationCycleId], references: [id], onDelete: Restrict)
 inverseStandardEvidence_accreditationStandardId StandardEvidence[] @relation("StandardEvidence_accreditationStandardId")
 inverseAssessmentMeasure_accreditationStandardId AssessmentMeasure[] @relation("AssessmentMeasure_accreditationStandardId")
 inverseSelfStudySection_accreditationStandardId SelfStudySection[] @relation("SelfStudySection_accreditationStandardId")
 inverseAccreditationFinding_accreditationStandardId AccreditationFinding[] @relation("AccreditationFinding_accreditationStandardId")
}

model StandardEvidence {
 id String @id @default(cuid())
 title String
 accreditationStandardId String
 sourceReference String
 collectedAt DateTime
 owner String
 description String
 status String @default("Draft")
 accreditationCycleId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([accreditationCycleId])
 linkedAccreditationStandardId AccreditationStandard @relation("StandardEvidence_accreditationStandardId", fields: [accreditationStandardId], references: [id], onDelete: Restrict)
 linkedAccreditationCycleId AccreditationCycle @relation("StandardEvidence_accreditationCycleId", fields: [accreditationCycleId], references: [id], onDelete: Restrict)
}

model AssessmentMeasure {
 id String @id @default(cuid())
